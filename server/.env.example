# Server port (default 3001)
PORT=3001

# JWT secret for auth (use a strong value in production)
JWT_SECRET=your-secret-here

# --- Database (choose one) ---

# PostgreSQL. When set, the app uses PostgreSQL.
# - On Railway: Railway sets DATABASE_URL automatically (internal URL like postgres.railway.internal:5432).
# - Local dev: use the public URL from Railway Postgres (Connect), e.g.:
#   DATABASE_URL=postgresql://user:password@proxy.rlwy.net:PORT/railway?sslmode=require

# SQLite (local dev). Used when DATABASE_URL is not set.
# DATABASE_PATH=./data/grantflow.db
