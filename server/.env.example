# Server port (default 3001)
PORT=3001

# Set to "production" when deploying. Required: JWT_SECRET must be set in production.
NODE_ENV=development

# JWT secret for auth (required in production; use a strong random value)
JWT_SECRET=your-secret-here

# Optional: comma-separated list of allowed CORS origins (e.g. https://app.example.com).
# If unset, all origins are allowed (dev-friendly). Restrict in production.
# CORS_ORIGIN=https://app.example.com,https://www.example.com

# --- Database (choose one) ---

# PostgreSQL. When set, the app uses PostgreSQL.
# - On Railway: Railway sets DATABASE_URL automatically.
# - Local: use the public URL from your Postgres provider (e.g. Railway Connect).
#   DATABASE_URL=postgresql://user:password@host:port/db?sslmode=require

# SQLite (local dev). Used when DATABASE_URL is not set.
# DATABASE_PATH=./data/grantflow.db
